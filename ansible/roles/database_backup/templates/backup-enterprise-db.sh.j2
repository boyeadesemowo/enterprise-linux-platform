#!/bin/bash
set -euo pipefail

BACKUP_DIR="{{ database_backup_directory }}"
DATABASE="{{ database_backup_name }}"
RETENTION_DAYS="{{ database_backup_retention_days }}"
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
BACKUP_FILE="${BACKUP_DIR}/${DATABASE}_${TIMESTAMP}.sql.gz"

mkdir -p "${BACKUP_DIR}"

mysqldump \
  --single-transaction \
  --routines \
  --triggers \
  "${DATABASE}" | gzip > "${BACKUP_FILE}"

sha256sum "${BACKUP_FILE}" > "${BACKUP_FILE}.sha256"

find "${BACKUP_DIR}" \
  -type f \
  \( -name "*.sql.gz" -o -name "*.sha256" \) \
  -mtime +"${RETENTION_DAYS}" \
  -delete

echo "Backup completed: ${BACKUP_FILE}"
