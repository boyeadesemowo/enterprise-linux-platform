# ============================================================
# Terraform
# ============================================================

**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

